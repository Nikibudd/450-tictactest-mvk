#!/bin/bash
# Einrichtung beim ersten Start (cloud-init). Das Jar bringt erst das Deployment nach /opt/tictactest.
set -euxo pipefail

dnf install -y "java-25-amazon-corretto-headless-${corretto_version}" "nginx-${nginx_version}"

# ttyd ist nicht im Amazon-Linux-Repository: feste Version, Prüfsumme wird kontrolliert
curl -fsSL -o /usr/local/bin/ttyd "https://github.com/tsl0922/ttyd/releases/download/${ttyd_version}/ttyd.x86_64"
echo "${ttyd_sha256}  /usr/local/bin/ttyd" | sha256sum -c -
chmod 755 /usr/local/bin/ttyd

# der Dienst läuft ohne Login-Shell und ohne Schreibrechte auf die Releases
useradd --system --no-create-home --shell /sbin/nologin tictactest
mkdir -p /opt/tictactest/releases

cat > /etc/systemd/system/tictactest.service <<'UNIT'
${service_unit}
UNIT

cat > /etc/nginx/conf.d/tictactest.conf <<'CONF'
${nginx_conf}
CONF

systemctl daemon-reload
systemctl enable --now nginx tictactest
